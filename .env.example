# ============================================
# GEOLOCATION
# ============================================
GOOGLE_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=
NOMINATIM_URL=https://nominatim.openstreetmap.org
DEFAULT_LAT=55.7558
DEFAULT_LNG=37.6173
DEFAULT_SEARCH_RADIUS_KM=50

# ============================================
# ANTI-FRAUD
# ============================================
IPQS_API_KEY=
FINGERPRINTJS_API_KEY=
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_API_PER_MIN=60

# === BRUTE FORCE DETECTION ===
# Эти пороги НЕ блокируют вход (блокировку делают throttle'ы admin-login и
# admin-login-by-email). Они только генерируют audit-события
# auth.brute_force_detected — когда паттерн попыток выглядит как атака,
# в AdminLog пишется отдельная запись с деталями. См. App\Services\AdminAuthService.
#
# Окно в минутах — общее для всех трёх порогов.
BRUTE_FORCE_WINDOW_MINUTES=15

# Порог 1: один IP + один email за окно — классический брутфорс одного аккаунта.
BRUTE_FORCE_THRESHOLD_IP_EMAIL=10

# Порог 2: один email со ВСЕХ IP за окно — distributed attack (прокси/ботнет).
BRUTE_FORCE_THRESHOLD_EMAIL=20

# Порог 3: один IP по ЛЮБЫМ email за окно — сканирование email-базы.
BRUTE_FORCE_THRESHOLD_IP_SCAN=30

# ============================================
# CORS
# ============================================
# Comma-separated список origin'ов, которым разрешено делать cross-origin
# запросы к API. С supports_credentials=true ( Sanctum cookie-auth) нельзя
# использовать '*' — только явные origin'ы.
# В проде: "https://example.com,https://admin.example.com"
# В dev: localhost:3000 (веб) + localhost:3001 (админка) — см. дефолт в config/cors.php.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Preflight-кэш в секундах. 0 = каждый запрос летит как actual (для dev).
# В проде поставь 86400 (1 день) — браузер закэширует preflight-ответ.
CORS_MAX_AGE=0

# ============================================
# MODERATION
# ============================================
AWS_REKOGNITION_REGION=us-east-1
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ============================================
# ANALYTICS & MONITORING
# ============================================
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.5
PULSE_ENABLED=true
PULSE_REDIS_CONNECTION=pulse

# ============================================
# WEBRTC
# ============================================
LIVEKIT_HOST=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TWILIO_VIDEO_SID=
TWILIO_VIDEO_TOKEN=

# ============================================
# HORIZON
# ============================================
HORIZON_DASHBOARD_ROUTE=horizon

# ============================================
# THROTTLE & LIMITS
