# ============================================
# APP
# ============================================
APP_NAME="Dating App"
APP_ENV=local
APP_KEY=base64:bdzqDZPBuKDUUHT8SEmaKlupXyLQIdEbftBxoyNBdsU=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

DEBUG_SQL=false

# ID владельцев - 1,2 (нельзя удалить или изменить роль)
APP_FOUNDERS=1,2

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=14
SESSION_ENCRYPT=true

# В dev — false (HTTP на localhost). В PROD — обязательно true (HTTPS only).
# Если не задано явно — config/session.php использует auto-дефолт:
# true при APP_ENV=production, иначе false. Но лучше фиксировать явно.
SESSION_SECURE_COOKIE=false

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=

# ============================================
# DATABASE
# ============================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dating_data
DB_USERNAME=devuser
DB_PASSWORD=devpass
DB_SSLMODE=prefer

# ============================================
# SESSION & SANCTUM (для SPA)
# ============================================

# БЫЛО: SESSION_DRIVER=cookie
# ПОЧЕМУ ПЛОХО: при driver=cookie ВСЯ сессия (id юзера, CSRF-токен, flash-данные)
# сериализуется, шифруется (у тебя SESSION_ENCRYPT=true) и кладётся В ОДНУ КУКУ.
# Лимит куки — 4 КБ. Переполнилась → браузер МОЛЧА выбрасывает куку →
# рандомные логауты, 401 и 419 «на ровном месте».
# СТАЛО: database — сессия живёт в таблице sessions, в куке только её ID.
# Если таблицы sessions нет: php artisan session:table && php artisan migrate
# (проверка: php artisan tinker -> Schema::hasTable('sessions'))
# Не хочешь таблицу — поставь SESSION_DRIVER=file, тоже рабочий вариант.
SESSION_DRIVER=database

SESSION_LIFETIME=120
SESSION_PATH=/

# БЫЛО: имя не задано → кука называлась Str::slug("Dating App") + "-session" =
# "dating-app-session", а middleware на Next (по твоим же комментариям) ждал
# "laravel_session" → он её НИКОГДА не видел → вечный редирект на /login.
# Фиксируем ОДНО имя на обеих сторонах (такое же в .env.local админки).
# P.S. после переименования куки ВСЕ (и веб, и админка) перелогинятся один раз —
# для local это норм.
SESSION_COOKIE=dating_session

# БЫЛО: SESSION_DOMAIN=localhost
# ПОЧЕМУ ПЛОХО: кука выходит с атрибутом Domain=localhost. localhost — не
# публичный домен, браузеры к этому капризны: Safari/iOS куку режут, Chrome
# ведёт себя нестабильно. Через Next rewrites запросы УЖЕ same-origin —
# атрибут Domain вообще не нужен.
# КАК УБИРАТЬ: строку ЗАКОММЕНТИРУЙ или удали ЦЕЛИКОМ (не оставляй пустой!).
# Закомментированная строка = честный null → атрибут Domain вообще не
# пишется в Set-Cookie. А `SESSION_DOMAIN=` (пустое значение) на некоторых
# версиях уезжает как Domain='' — нам такой вариант не нужен.
# (На проде с поддоменами — Domain=.example.com, отдельная история.)
# SESSION_DOMAIN=localhost
# (SESSION_SECURE_COOKIE перенесён в секцию SECURITY выше — там же комментарий про prod.)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Обязателььно 1-й урл - веб, 2-й - админка !!!! Важноо !!!
FRONTEND_URL=http://localhost:3000,http://localhost:3001

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000,127.0.0.1:3000,localhost:3001,127.0.0.1:3001
SANCTUM_TOKEN_EXPIRATION=525600

# ============================================
# CACHE & QUEUE — ВСЁ ЧЕРЕЗ REDIS
# ============================================
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# ============================================
# BROADCASTING — REALTIME
# ============================================
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_TLS_HOST=
REVERB_TLS_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================
# REDIS
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_BROADCAST_DB=3

# ============================================
# FILESYSTEM
# ============================================
FILESYSTEM_DISK=local
FILESYSTEM_DRIVER=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1
