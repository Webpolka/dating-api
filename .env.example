# ============================================
# FRONTEND (Vite)
# ============================================
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_FRONTEND_URL="${FRONTEND_URL}"
MAIL_ENCRYPTION=null
